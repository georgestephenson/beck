# Blocks: §1.1.7, §1.3.3, §1.3.4, §2.1.1, and every numerical exercise in the book.
#
# §1.1.7 is "Example: Square Roots by Newton's Method" — the first substantial program in SICP, and
# the one the whole of §1.3 (`fixed-point`, `average-damp`, `newton-transform`) is built out of. It
# needs real arithmetic. `Float` is a type Beck knows — `prelude.rs` gives it a type-constructor
# arity — but no primitive operates on it: `+`, `-`, `*`, `/` and `<` are Int-only, and there is no
# `abs` and no `sqrt`.
#
# error[B0320]: operand of `+` mismatch: expected `Int`, found `Float`
#
# SICP also assumes exact rational arithmetic in places (§1.2.2's exercises, §2.1.1's whole point)
# and bignums elsewhere (factorial and `fast-expt` overflow small integers quickly). The numeric
# tower is a standard-library question — Phase 3's "standard library v1: collections, strings,
# time, money/decimal" — and the suite dates it rather than discovering it.

def average(x: Float, y: Float) -> Float:
    return (x + y) / 2.0

def improve(guess: Float, x: Float) -> Float:
    return average(guess, x / guess)

def sqrt_iter(guess: Float, x: Float) -> Float:
    if good_enough(guess, x):
        return guess
    return sqrt_iter(improve(guess, x), x)

def good_enough(guess: Float, x: Float) -> Bool:
    return abs(guess * guess - x) < 0.001

def sqrt(x: Float) -> Float:
    return sqrt_iter(1.0, x)
