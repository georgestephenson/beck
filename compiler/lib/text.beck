# Text handling, written in Beck on top of the string primitives.
#
# The division this directory exists to make: `str_upper` is a Unicode table and `str_split` is an
# allocation strategy, so both are primitives the host provides. Everything here is *composition* —
# lines, words, padding, a title case — and composition is what the language is for. Writing it in
# Rust would have been faster to run and would have proved nothing.
#
# It also exercises the primitives, which is the second reason it is here rather than in a Rust
# test: a standard library that is only ever called from a harness is a standard library nobody has
# used.

## Split on newlines, dropping a single trailing one.
##
## A file that ends in a newline has the same lines as one that does not, which is what every tool
## that reads a file means by "lines" and what `str_split` alone does not give you. An empty string
## therefore has no lines rather than one empty one.
def lines(text: Str) -> list[Str]:
    parts = str_split(text, "\n")
    if list_len(parts) > 0 and unwrap_or(list_get(parts, list_len(parts) - 1), "x") == "":
        return list_take(parts, list_len(parts) - 1)
    return parts

## Split on whitespace, dropping the empty runs.
##
## `str_split(s, " ")` gives `["a", "", "b"]` for `"a  b"`, which is correct for a split and wrong
## for words — so the difference is one `filter_list`, and having to write it is the point.
def words(text: Str) -> list[Str]:
    return filter_list(str_split(str_trim(text), " "), lambda w: not str_is_empty(str_trim(w)))

def word_count(text: Str) -> Int:
    return list_len(words(text))

def pad_left(text: Str, width: Int, fill: Str) -> Str:
    missing = width - str_len(text)
    if missing <= 0:
        return text
    return str_slice(str_repeat(fill, missing), 0, missing) + text

def pad_right(text: Str, width: Int, fill: Str) -> Str:
    missing = width - str_len(text)
    if missing <= 0:
        return text
    return text + str_slice(str_repeat(fill, missing), 0, missing)

def capitalise(word: Str) -> Str:
    if str_is_empty(word):
        return word
    return str_upper(str_slice(word, 0, 1)) + str_lower(str_slice(word, 1, str_len(word)))

def title_case(text: Str) -> Str:
    return str_join(map_list(words(text), capitalise), " ")

## Shorten to `width`, ending in `…` if anything was dropped.
##
## The ellipsis counts towards the width, because a "truncate to 10" that returns 11 characters is
## the bug this function exists to not have.
def truncate(text: Str, width: Int) -> Str:
    if str_len(text) <= width or width <= 0:
        return text
    if width == 1:
        return "…"
    return str_slice(text, 0, width - 1) + "…"

## Is `text` a `prefix` of nothing else? Case-insensitively, which is the comparison a search box
## wants and the one `str_starts_with` deliberately does not make for you.
def starts_with_fold(text: Str, prefix: Str) -> Bool:
    return str_starts_with(str_lower(text), str_lower(prefix))

## `"a,b" → {"a": "", "b": ""}` is not what anybody means, so this takes pairs.
##
## `parse_pairs("a=1;b=2", ";", "=")` is `{"a": "1", "b": "2"}`. A pair with no separator is
## skipped rather than raising: this is a *tolerant* reader for things like a cookie header, and a
## strict one would be a different function with a `raises` in its row.
def parse_pairs(text: Str, between: Str, within: Str) -> Map[Str, Str]:
    return list_fold(
        str_split(text, between),
        no_pairs(),
        lambda acc, part: add_pair(acc, str_trim(part), within),
    )

## An empty `Map[Str, Str]`, because `{}` on its own is not one yet.
##
## A record literal is checked against an expectation, and the second argument of `list_fold` has
## none to offer: its type is only decided once the *third* argument has been read. Writing the
## empty map behind a signature is how a program says which map it means, and it is worth one
## definition rather than a change to the order the checker reads arguments in.
def no_pairs() -> Map[Str, Str]:
    return {}

def add_pair(acc: Map[Str, Str], part: Str, within: Str) -> Map[Str, Str]:
    match str_index_of(part, within):
        case None:
            return acc
        case Some(at):
            return map_insert(
                acc,
                str_trim(str_slice(part, 0, at)),
                str_trim(str_slice(part, at + str_len(within), str_len(part))),
            )

# ---------------------------------------------------------------------------------------------

test "lines are lines, and a trailing newline is not one":
    expect lines("a\nb\n") == ["a", "b"]
    expect lines("a\nb") == ["a", "b"]
    # An empty file has no lines, which is the answer `wc -l` gives and the one a `for` over the
    # result wants.
    expect lines("") == []

test "words drop the empty runs a split leaves behind":
    expect words("  the   quick brown  ") == ["the", "quick", "brown"]
    expect word_count("the quick brown fox") == 4
    expect words("") == []

test "padding stops at the width and never overshoots":
    expect pad_left("7", 3, "0") == "007"
    expect pad_right("ab", 4, ".") == "ab.."
    expect pad_left("toolong", 3, "0") == "toolong"

test "case, over characters rather than bytes":
    expect capitalise("hello") == "Hello"
    expect capitalise("HELLO") == "Hello"
    expect capitalise("") == ""
    expect title_case("the quick brown fox") == "The Quick Brown Fox"
    expect starts_with_fold("Hello World", "hello")

test "truncation counts the ellipsis":
    expect truncate("hello", 10) == "hello"
    expect truncate("hello", 3) == "he…"
    expect str_len(truncate("hello", 3)) == 3
    expect truncate("hello", 1) == "…"

test "a tolerant pair reader skips what it cannot read":
    expect parse_pairs("a=1; b=2", ";", "=") == {"a": "1", "b": "2"}
    expect parse_pairs("a=1; oops; b=2", ";", "=") == {"a": "1", "b": "2"}
    expect parse_pairs("", ";", "=") == {}

property "padding never shortens, and reaches the width when it can"(width: Int):
    expect str_len(pad_left("ab", width % 40, "-")) >= 2
