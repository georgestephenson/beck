# The vocabulary: what exists, what may be asked, what is recorded.

type Id = newtype[Str]

model Todo:
    id: Id
    text: Str
    done: Bool
    owner: Str

model State:
    todos: Map[Id, Todo]

union Command:
    Add(id: Id, text: Str)
    Toggle(id: Id)

union Event:
    Added(id: Id, text: Str)
    Toggled(id: Id)

union Rejection:
    BlankText
    NotOwner

def apply_event(s: State, env: Envelope[Event]) -> State:
    match env.body:
        case Added(id, text):
            return s.with(todos=map_insert(s.todos, id, Todo(id=id, text=text, done=False, owner=env.actor)))
        case Toggled(id):
            return toggled(s, id)

def toggled(s: State, id: Id) -> State:
    match map_get(s.todos, id):
        case Some(value):
            return s.with(todos=map_insert(s.todos, id, value.with(done=not value.done)))
        case None:
            return s

# The project's first user-written *polymorphic* definitions, and the reason they are here rather
# than in `sicp/`: a generic signature that crosses a `.becki` boundary is a different claim from
# one that does not. `beck iface` publishes `[T]`, the importing module instantiates it afresh per
# call, and `app.beck` uses both at two different element types — which is the thing that would
# silently over-constrain if the published scheme were monomorphic (docs/32 §32.8).

def only[T](xs: list[T], keep: T -> Bool) -> list[T]:
    return filter_list(xs, keep)

def count_where[T](xs: list[T], keep: T -> Bool) -> Int:
    return list_len(only(xs, keep))

# The project's first *trait*, and the reason it is here rather than in a single file: what a call
# in another module resolves against is the published header, not the body. `beck iface` writes the
# trait and the `impl` line; `app.beck` calls `label()` on a `Todo` it imported and never sees the
# implementation (docs/40 §40.3).

trait Labelled:
    def label(self) -> Str

impl Labelled for Todo:
    def label(self):
        return self.text

# A bounded definition that crosses the boundary. The dictionary parameter it is lowered with is not
# part of the contract — the *bound* is, and the importing module rebuilds the parameter from it.
def labels[T: Labelled](xs: list[T]) -> list[Str]:
    return map_list(xs, lambda x: x.label())
