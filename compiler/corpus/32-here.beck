# Who is in the room *now*, which is the one thing on this page that is not in the log.
#
# `15-presence.beck` next door writes presence the way a program had to write it before this one
# could exist: arrive and leave are commands, so the roster is a fold and a client that closed its
# laptop is here forever. This is D6's answer — `presence()` is a source in the signal graph, the
# runtime holds it, and nothing about it is appended, snapshotted or replayed.
#
# Three things follow, and the program is written so that each is visible:
#
#   * the roster is **server-placed without an annotation**, because `presence()` performs
#     `cap.presence` and no tier below the server discharges a capability (§3.3);
#   * the page is a `map2` of the accumulator and the roster, so the two arrive at one view from
#     two different kinds of place — one that replays and one that does not;
#   * `validate` cannot see it. It is not that this program declines to decide from the roster;
#     the chokepoint reading it is `B0515`.
#
# Like every program here it carries no placement annotations and has to place itself.

model State:
    notes: Map[Str, Str]

# The accumulator and the roster, met. Named because a view is a function of a value, and this is
# the value: what was recorded, beside who is looking.
model Room:
    notes: Map[Str, Str]
    here: Map[Str, Int]

union Command:
    Post(text: Str)

union Event:
    Posted(text: Str)

union Rejection:
    Blank

def apply_event(s: State, env: Envelope[Event]) -> State:
    match env.body:
        case Posted(text):
            return s.with(notes=map_insert(s.notes, env.actor, text))

def validate(s: State, p: Proposal) -> Result[list[Event], Rejection]:
    match p.command:
        case Post(text):
            if str_is_empty(str_trim(text)):
                return Err(error=Blank)
            return Ok(value=[Posted(text=text)])

def combine(s: State, here: Map[Str, Int]) -> Room:
    return Room(notes=s.notes, here=here)

def view(r: Room, session: Session) -> Html:
    return ui:
        main:
            h1: "standup"
            p: (str(map_len(r.here)) + " here")
            ul:
                for who in map_keys(r.here):
                    li(key=who): (who + note_of(r, who))
            footer: ("you are " + session.actor)

def note_of(r: Room, who: Str) -> Str:
    match map_get(r.notes, who):
        case Some(value):
            return ": " + value
        case None:
            return " — nothing yet"

proposals: Stream[Proposal] = merge_clients()
events: Stream[Event] = decide(proposals, board, validate)
board: Signal[State] = durable(fold(apply_event, State(notes={}), events))
here: Signal[Map[Str, Int]] = presence()
page: Signal[Html] = per_session(map2(combine, board, here), view)

# A test renders the page one actor sees while looking at it, so the roster it renders against is
# that actor and nobody else. That is the whole of what `beck test` can say about presence: there
# is one connection in a test, and it is the one the expectation names.
test "the page counts whoever is looking at it":
    given []
    expect page(session("ana")) contains "1 here"
    expect page(session("ana")) contains "ana — nothing yet"

test "a note appears beside its author":
    given [Posted(text="shipping the slicer")] by "ana"
    expect page(session("ana")) contains "ana: shipping the slicer"

test "a blank note never reaches the log":
    given []
    when Post(text="   ")
    expect Err(error=Blank)

test "the roster is the server's and the page is the browser's":
    expect place(here) == server
    expect place(board) == data
    expect place(page) == client

property "no log this program can produce makes the page unrenderable"(log: list[Event]):
    given log
    expect page contains "here"
