# Are We Fast Yet — Json.
#
# The second of the five macro-benchmarks. It is a JSON parser run over 25,820 characters of
# minified RAP protocol traffic, and what is verified is the shape of what comes back: an object,
# whose `head` is an object and whose `operations` is an array of 156 entries.
#
# The parser is the benchmark. Beck has `json_parse` as a primitive — `docs/46` §46.2 puts a grammar
# on the host's side of `lib/README.md`'s division — and calling it here would measure Rust's
# `serde` and prove nothing about Beck, which is exactly the substitution Are We Fast Yet's
# methodology exists to forbid. So this is a recursive-descent parser written out.
#
# **The port is a transcription except for one thing**, and it is the finding `docs/53` §53.2
# forecast: the original indexes its input with `input.substring(index, index + 1)`, and Beck's
# `str_slice` counts in characters from the start, so a reader that indexed the `Str` directly would
# be quadratic in the length of the input. The input is turned into a `list[Str]` once by
# `str_chars`, and `list_get` on a list is an index rather than a walk. One line at the top, and the
# rest reads as the Java does.
#
# The other difference is that the reader is a **value**: `Reader` is the input and a position, and
# every function that consumed a character returns the reader it left behind. Java mutates `index`
# and `current` on a field. `docs/53` §53.4's third rule, applied to a parser rather than to a
# scheduler.

## A JSON value.
##
## The prelude already has a `Json` type and a `json_parse` primitive, and this benchmark uses
## **neither** — which is the whole reason it is in the suite. The names here are the original's own
## classes so the two cannot be confused.
##
## Six variants where the original has a `JsonValue` hierarchy of seven classes. `JsonLiteral`'s
## three constants — null, true and false — are two variants here, which is the one place the shape
## differs and it differs in the direction a union makes obvious.
union JsonValue:
    NullValue
    BoolValue(value: Bool)
    StringValue(text: Str)
    ## The digits as written. The original keeps the literal too — `JsonNumber` holds a `String` —
    ## because a parser that converted would be measuring the conversion.
    NumberValue(literal: Str)
    ArrayValue(items: list[JsonValue])
    ## Names and values in parallel, which is what `JsonObject` holds. The original also keeps a
    ## `HashIndexTable` for lookup; this is a scan, and §53.4 says what that changes.
    ObjectValue(names: list[Str], values: list[JsonValue])

union ParseException:
    ## The original's `ParseException`, with the index it carries.
    Expected(what: Str, at: Int)
    NotAValue(at: Int)
    UnexpectedEnd(at: Int)
    UnexpectedCharacter(at: Int)

## The input and a position in it.
##
## `chars` is the whole input as one character per element. That is the one liberty the port takes
## and the header says why.
model Reader:
    chars: list[Str]
    index: Int

## A value, and the reader positioned after it.
model Parsed:
    value: JsonValue
    reader: Reader

## Text, and the reader positioned after it.
model Captured:
    text: Str
    reader: Reader

def advance(r: Reader) -> Reader:
    return Reader(chars=r.chars, index=r.index + 1)

## The character under the reader, or `""` at the end of the input — which is the original's `null`
## and is a value no single character can be.
def current(r: Reader) -> Str:
    return unwrap_or(list_get(r.chars, r.index), "")

def at_end(r: Reader) -> Bool:
    return r.index >= list_len(r.chars)

## The characters from `start` up to where the reader is now — the original's `startCapture` and
## `endCapture`, which are a pair of indices there and a slice here.
def span_of(r: Reader, start: Int) -> Str:
    return str_join(list_slice(r.chars, start, r.index - start), "")

def is_white(c: Str) -> Bool:
    return c == " " or c == "\t" or c == "\n" or c == "\r"

## The original enumerates the ten digits; a range says the same thing about one ASCII character.
def is_digit(c: Str) -> Bool:
    return c >= "0" and c <= "9"

def skip_white(r: Reader) -> Reader:
    if is_white(current(r)):
        return skip_white(advance(r))
    return r

def digits_from(r: Reader) -> Reader:
    if is_digit(current(r)):
        return digits_from(advance(r))
    return r

## The original's `readRequiredChar` run over a whole word — `null`, `true`, `false`.
def expect_word(r: Reader, word: Str) -> Reader uses raises(ParseException):
    return expect_from(r, str_chars(word), 0)

def expect_from(r: Reader, letters: list[Str], i: Int) -> Reader uses raises(ParseException):
    if i >= list_len(letters):
        return r
    wanted = unwrap_or(list_get(letters, i), "")
    if current(r) != wanted:
        raise Expected(what=wanted, at=r.index)
    return expect_from(advance(r), letters, i + 1)

# ---------------------------------------------------------------------------------------------
# The grammar
# ---------------------------------------------------------------------------------------------

def read_value(r: Reader) -> Parsed uses raises(ParseException):
    c = current(r)
    if c == "n":
        return Parsed(value=NullValue, reader=expect_word(r, "null"))
    if c == "t":
        return Parsed(value=BoolValue(value=true), reader=expect_word(r, "true"))
    if c == "f":
        return Parsed(value=BoolValue(value=false), reader=expect_word(r, "false"))
    if c == "\"":
        captured = read_string(r)
        return Parsed(value=StringValue(text=captured.text), reader=captured.reader)
    if c == "[":
        return read_array(r)
    if c == "{":
        return read_object(r)
    if c == "-" or is_digit(c):
        return read_number(r)
    raise NotAValue(at=r.index)

def read_array(r: Reader) -> Parsed uses raises(ParseException):
    opened = skip_white(advance(r))
    if current(opened) == "]":
        return Parsed(value=ArrayValue(items=[]), reader=advance(opened))
    return array_items(opened, [])

## The original's `do { … } while (readChar(","))`, as a tail call.
def array_items(r: Reader, done: list[JsonValue]) -> Parsed uses raises(ParseException):
    element = read_value(skip_white(r))
    after = skip_white(element.reader)
    items = list_append(done, element.value)
    if current(after) == ",":
        return array_items(advance(after), items)
    if current(after) != "]":
        raise Expected(what="]", at=after.index)
    return Parsed(value=ArrayValue(items=items), reader=advance(after))

def read_object(r: Reader) -> Parsed uses raises(ParseException):
    opened = skip_white(advance(r))
    if current(opened) == "}":
        return Parsed(value=ObjectValue(names=[], values=[]), reader=advance(opened))
    return object_members(opened, [], [])

def object_members(
    r: Reader, names: list[Str], values: list[JsonValue]
) -> Parsed uses raises(ParseException):
    name = read_name(skip_white(r))
    colon = skip_white(name.reader)
    if current(colon) != ":":
        raise Expected(what=":", at=colon.index)
    member = read_value(skip_white(advance(colon)))
    after = skip_white(member.reader)
    with_name = list_append(names, name.text)
    with_value = list_append(values, member.value)
    if current(after) == ",":
        return object_members(advance(after), with_name, with_value)
    if current(after) != "}":
        raise Expected(what="}", at=after.index)
    return Parsed(
        value=ObjectValue(names=with_name, values=with_value), reader=advance(after)
    )

def read_name(r: Reader) -> Captured uses raises(ParseException):
    if current(r) != "\"":
        raise Expected(what="name", at=r.index)
    return read_string(r)

## The original's `readStringInternal`: take the run between escapes as one slice, and only the
## escapes a character at a time. `pauseCapture`/`startCapture` there, `start` here.
def read_string(r: Reader) -> Captured uses raises(ParseException):
    opened = advance(r)
    return capture_from(opened, opened.index, "")

def capture_from(r: Reader, start: Int, done: Str) -> Captured uses raises(ParseException):
    if at_end(r):
        raise UnexpectedEnd(at=r.index)
    c = current(r)
    if c == "\"":
        return Captured(text=done + span_of(r, start), reader=advance(r))
    if c == "\\":
        escaped = read_escape(advance(r))
        return capture_from(
            escaped.reader, escaped.reader.index, done + span_of(r, start) + escaped.text
        )
    return capture_from(advance(r), start, done)

## The original's `readEscape`. `\u` is **not** here, and that is the original's choice too: it
## throws "valid escape sequence" for one, so a port that accepted it would accept more than the
## benchmark does.
def read_escape(r: Reader) -> Captured uses raises(ParseException):
    c = current(r)
    if c == "\"" or c == "/" or c == "\\":
        return Captured(text=c, reader=advance(r))
    if c == "b":
        return Captured(text="\u{8}", reader=advance(r))
    if c == "f":
        return Captured(text="\u{c}", reader=advance(r))
    if c == "n":
        return Captured(text="\n", reader=advance(r))
    if c == "r":
        return Captured(text="\r", reader=advance(r))
    if c == "t":
        return Captured(text="\t", reader=advance(r))
    raise Expected(what="valid escape sequence", at=r.index)

## The original's `readNumber`, `readFraction` and `readExponent`, which between them accept exactly
## JSON's grammar for a number and keep the text.
def read_number(r: Reader) -> Parsed uses raises(ParseException):
    start = r.index
    signed = advance(r) if current(r) == "-" else r
    first = current(signed)
    if not is_digit(first):
        raise Expected(what="digit", at=signed.index)
    integral = advance(signed) if first == "0" else digits_from(advance(signed))
    ended = read_exponent(read_fraction(integral))
    return Parsed(value=NumberValue(literal=span_of(ended, start)), reader=ended)

def read_fraction(r: Reader) -> Reader uses raises(ParseException):
    if current(r) != ".":
        return r
    after = advance(r)
    if not is_digit(current(after)):
        raise Expected(what="digit", at=after.index)
    return digits_from(advance(after))

def read_exponent(r: Reader) -> Reader uses raises(ParseException):
    if current(r) != "e" and current(r) != "E":
        return r
    after = advance(r)
    signed = advance(after) if current(after) == "+" or current(after) == "-" else after
    if not is_digit(current(signed)):
        raise Expected(what="digit", at=signed.index)
    return digits_from(advance(signed))

## The original's `parse`: one value, surrounded by optional space, and nothing after it.
def parse(text: Str) -> JsonValue uses raises(ParseException):
    parsed = read_value(skip_white(Reader(chars=str_chars(text), index=0)))
    rest = skip_white(parsed.reader)
    if not at_end(rest):
        raise UnexpectedCharacter(at=rest.index)
    return parsed.value

# ---------------------------------------------------------------------------------------------
# `JsonValue`'s three questions, which are what `verifyResult` asks
# ---------------------------------------------------------------------------------------------

def is_object(value: JsonValue) -> Bool:
    match value:
        case NullValue:
            return false
        case BoolValue(b):
            return false
        case StringValue(text):
            return false
        case NumberValue(literal):
            return false
        case ArrayValue(items):
            return false
        case ObjectValue(names, values):
            return true

def is_array(value: JsonValue) -> Bool:
    match value:
        case NullValue:
            return false
        case BoolValue(b):
            return false
        case StringValue(text):
            return false
        case NumberValue(literal):
            return false
        case ArrayValue(items):
            return true
        case ObjectValue(names, values):
            return false

## The number of entries in an array, and `-1` for anything else — which no caller here reaches,
## because `verifyResult` asks `isArray` first.
def size_of(value: JsonValue) -> Int:
    match value:
        case NullValue:
            return -1
        case BoolValue(b):
            return -1
        case StringValue(text):
            return -1
        case NumberValue(literal):
            return -1
        case ArrayValue(items):
            return list_len(items)
        case ObjectValue(names, values):
            return -1

## `JsonObject.get`, as a scan.
##
## The original keeps a `HashIndexTable` alongside the two vectors and consults it here. This is a
## linear walk of the names, which is the same answer and less work per `add` — §53.4 records it as
## the one place the port does less than the original rather than the same.
def field(value: JsonValue, name: Str) -> JsonValue:
    match value:
        case NullValue:
            return NullValue
        case BoolValue(b):
            return NullValue
        case StringValue(text):
            return NullValue
        case NumberValue(literal):
            return NullValue
        case ArrayValue(items):
            return NullValue
        case ObjectValue(names, values):
            return named(names, values, name, 0)

def named(names: list[Str], values: list[JsonValue], name: Str, i: Int) -> JsonValue:
    if i >= list_len(names):
        return NullValue
    if unwrap_or(list_get(names, i), "") == name:
        return unwrap_or(list_get(values, i), NullValue)
    return named(names, values, name, i + 1)

## The benchmark: parse the input, and ask `verifyResult`'s four questions of what comes back.
def benchmark() -> Bool uses raises(ParseException):
    result = parse(rap_benchmark_minified())
    if not is_object(result):
        return false
    if not is_object(field(result, "head")):
        return false
    if not is_array(field(result, "operations")):
        return false
    return size_of(field(result, "operations")) == 156

test "json: the RAP trace parses, and its operations are the 156 the suite counts":
    expect (try: benchmark()) == Ok(value=true)

## The escape cases the benchmark's own input never reaches — it has no backslash in 25,820
## characters — so they are checked here rather than left to be believed.
test "the escapes the original accepts, and the one it does not":
    expect (try: parse("\"a\\\"b\"")) == Ok(value=StringValue(text="a\"b"))
    expect (try: parse("\"a\\nb\"")) == Ok(value=StringValue(text="a\nb"))
    expect (try: parse("\"\\t\\r\\/\\\\\"")) == Ok(value=StringValue(text="\t\r/\\"))
    expect (try: parse("\"\\u0041\"")) == Err(error=Expected(what="valid escape sequence", at=2))

test "the grammar, on the shapes the trace does not contain":
    expect (try: parse("null")) == Ok(value=NullValue)
    expect (try: parse("  true ")) == Ok(value=BoolValue(value=true))
    expect (try: parse("false")) == Ok(value=BoolValue(value=false))
    expect (try: parse("[]")) == Ok(value=ArrayValue(items=[]))
    expect (try: parse("{}")) == Ok(value=ObjectValue(names=[], values=[]))
    expect (try: parse("-0.5e+10")) == Ok(value=NumberValue(literal="-0.5e+10"))
    expect (try: parse("[1, 2]")) == Ok(
        value=ArrayValue(items=[NumberValue(literal="1"), NumberValue(literal="2")])
    )
    expect (try: parse("1 2")) == Err(error=UnexpectedCharacter(at=2))
    expect (try: parse("[1,]")) == Err(error=NotAValue(at=3))
    expect (try: parse("01")) == Err(error=UnexpectedCharacter(at=1))

## The 25,820 characters of minified RAP protocol traffic the original embeds, verbatim.
def rap_benchmark_minified() -> Str:
    return "{\"head\":{\"requestCounter\":4},\"operations\":[[\"destroy\",\"w54\"],[\"set\",\"w2\",{\"activeControl\":\"w99\"}],[\"set\",\"w21\",{\"customVariant\":\"variant_navigation\"}],[\"set\",\"w28\",{\"customVariant\":\"variant_selected\"}],[\"set\",\"w53\",{\"children\":[\"w95\"]}],[\"create\",\"w95\",\"rwt.widgets.Composite\",{\"parent\":\"w53\",\"style\":[\"NONE\"],\"bounds\":[0,0,1008,586],\"children\":[\"w96\",\"w97\"],\"tabIndex\":-1,\"clientArea\":[0,0,1008,586]}],[\"create\",\"w96\",\"rwt.widgets.Label\",{\"parent\":\"w95\",\"style\":[\"NONE\"],\"bounds\":[10,30,112,26],\"tabIndex\":-1,\"customVariant\":\"variant_pageHeadline\",\"text\":\"TableViewer\"}],[\"create\",\"w97\",\"rwt.widgets.Composite\",{\"parent\":\"w95\",\"style\":[\"NONE\"],\"bounds\":[0,61,1008,525],\"children\":[\"w98\",\"w99\",\"w226\",\"w228\"],\"tabIndex\":-1,\"clientArea\":[0,0,1008,525]}],[\"create\",\"w98\",\"rwt.widgets.Text\",{\"parent\":\"w97\",\"style\":[\"LEFT\",\"SINGLE\",\"BORDER\"],\"bounds\":[10,10,988,32],\"tabIndex\":22,\"activeKeys\":[\"#13\",\"#27\",\"#40\"]}],[\"listen\",\"w98\",{\"KeyDown\":true,\"Modify\":true}],[\"create\",\"w99\",\"rwt.widgets.Grid\",{\"parent\":\"w97\",\"style\":[\"SINGLE\",\"BORDER\"],\"appearance\":\"table\",\"indentionWidth\":0,\"treeColumn\":-1,\"markupEnabled\":false}],[\"create\",\"w100\",\"rwt.widgets.ScrollBar\",{\"parent\":\"w99\",\"style\":[\"HORIZONTAL\"]}],[\"create\",\"w101\",\"rwt.widgets.ScrollBar\",{\"parent\":\"w99\",\"style\":[\"VERTICAL\"]}],[\"set\",\"w99\",{\"bounds\":[10,52,988,402],\"children\":[],\"tabIndex\":23,\"activeKeys\":[\"CTRL+#70\",\"CTRL+#78\",\"CTRL+#82\",\"CTRL+#89\",\"CTRL+#83\",\"CTRL+#71\",\"CTRL+#69\"],\"cancelKeys\":[\"CTRL+#70\",\"CTRL+#78\",\"CTRL+#82\",\"CTRL+#89\",\"CTRL+#83\",\"CTRL+#71\",\"CTRL+#69\"]}],[\"listen\",\"w99\",{\"MouseDown\":true,\"MouseUp\":true,\"MouseDoubleClick\":true,\"KeyDown\":true}],[\"set\",\"w99\",{\"itemCount\":118,\"itemHeight\":28,\"itemMetrics\":[[0,0,50,3,0,3,44],[1,50,50,53,0,53,44],[2,100,140,103,0,103,134],[3,240,180,243,0,243,174],[4,420,50,423,0,423,44],[5,470,50,473,0,473,44]],\"columnCount\":6,\"headerHeight\":35,\"headerVisible\":true,\"linesVisible\":true,\"focusItem\":\"w108\",\"selection\":[\"w108\"]}],[\"listen\",\"w99\",{\"Selection\":true,\"DefaultSelection\":true}],[\"set\",\"w99\",{\"enableCellToolTip\":true}],[\"listen\",\"w100\",{\"Selection\":true}],[\"set\",\"w101\",{\"visibility\":true}],[\"listen\",\"w101\",{\"Selection\":true}],[\"create\",\"w102\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Nr.\",\"width\":50,\"moveable\":true}],[\"listen\",\"w102\",{\"Selection\":true}],[\"create\",\"w103\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Sym.\",\"index\":1,\"left\":50,\"width\":50,\"moveable\":true}],[\"listen\",\"w103\",{\"Selection\":true}],[\"create\",\"w104\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Name\",\"index\":2,\"left\":100,\"width\":140,\"moveable\":true}],[\"listen\",\"w104\",{\"Selection\":true}],[\"create\",\"w105\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Series\",\"index\":3,\"left\":240,\"width\":180,\"moveable\":true}],[\"listen\",\"w105\",{\"Selection\":true}],[\"create\",\"w106\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Group\",\"index\":4,\"left\":420,\"width\":50,\"moveable\":true}],[\"listen\",\"w106\",{\"Selection\":true}],[\"create\",\"w107\",\"rwt.widgets.GridColumn\",{\"parent\":\"w99\",\"text\":\"Period\",\"index\":5,\"left\":470,\"width\":50,\"moveable\":true}],[\"listen\",\"w107\",{\"Selection\":true}],[\"create\",\"w108\",\"rwt.widgets.GridItem\",{\"parent\":\"w99\",\"index\":0,\"texts\":[\"1\",\"H\",\"Hydrogen\",\"Nonmetal\",\"1\",\"1\"],\"cellBackgrounds\":[null,null,null,[138,226,52,255],null,null]}],[\"create\",\"w109\",\"rwt.widgets.GridItem\",{\"parent\":\"w99\",\"index\":1,\"texts\":[\"2\",\"He\",\"Helium\",\"Noble gas\",\"18\",\"1\"],\"cellBackgrounds\":[null,null,null,[114,159,207,255],null,