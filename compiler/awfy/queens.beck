# Are We Fast Yet — Queens.
#
# Eight queens, solved ten times. The Java keeps three `boolean[]` of free rows and free diagonals
# plus an `int[]` of placements, sets them on the way down and unsets them on the way back up. The
# port keeps the same four arrays as maps and simply *does not unset*: backtracking is returning to
# the board the caller still holds, so the undo the original needs is the one thing a value cannot
# require.
#
# That is the only real difference between the two, and it is worth stating plainly rather than
# celebrating: it removes four assignments per rejected placement and it is not a different
# algorithm. The search visits the same nodes in the same order.
#
# `verifyResult` in the original is `(boolean) result`, so the number here is `true`.

model Board:
    ## Absent reads as free, which is what `Arrays.fill(freeRows, true)` sets up.
    free_rows: Map[Int, Bool]
    free_maxs: Map[Int, Bool]
    free_mins: Map[Int, Bool]
    ## Written and never read, exactly as in the original. It is the work the benchmark is
    ## measuring, so dropping it would make this file faster than the thing it is a port of.
    queen_rows: Map[Int, Int]

def empty_board() -> Board:
    return Board(free_rows={}, free_maxs={}, free_mins={}, queen_rows={})

def free_at(b: Board, r: Int, c: Int) -> Bool:
    return (
        unwrap_or(map_get(b.free_rows, r), true)
        and unwrap_or(map_get(b.free_maxs, c + r), true)
        and unwrap_or(map_get(b.free_mins, c - r + 7), true)
    )

def occupy(b: Board, r: Int, c: Int) -> Board:
    return Board(
        free_rows=map_insert(b.free_rows, r, false),
        free_maxs=map_insert(b.free_maxs, c + r, false),
        free_mins=map_insert(b.free_mins, c - r + 7, false),
        queen_rows=map_insert(b.queen_rows, r, c),
    )

def place_queen(c: Int, b: Board) -> Bool:
    return try_row(0, c, b)

## The original's `for r = 0 … 7`, and the one place in this directory where the transcription
## could not be literal.
##
## `if (getRowColumn(r, c)) { … if (placeQueen(c + 1)) …` is two nested tests in Java and reads as
## one `and` — but Beck's `and` is a primitive over two `Bool`s and **evaluates both operands**, so
## writing it that way searches from squares that are already attacked and turns a 2,057-node
## search into an 8⁸ one. Nested, not conjoined, and `docs/53` §53.5 is why that is a finding
## rather than a style note.
def try_row(r: Int, c: Int, b: Board) -> Bool:
    if r >= 8:
        return false
    if free_at(b, r, c):
        return solved_or_next(settles(r, c, occupy(b, r, c)), r, c, b)
    return try_row(r + 1, c, b)

## `if (placeQueen(c + 1)) { return true; }` and the fall-through after it, as one function.
##
## The search is run *before* this is entered, which is what the original does at the same point;
## what a strict `or` would change is the other half — `settles(…) or try_row(…)` searches the rest
## of the column whether or not the queen was placed.
def solved_or_next(solved: Bool, r: Int, c: Int, b: Board) -> Bool:
    if solved:
        return true
    return try_row(r + 1, c, b)

## The last column is a solution; anything else has to place the next one.
def settles(r: Int, c: Int, placed: Board) -> Bool:
    if c == 7:
        return true
    return place_queen(c + 1, placed)

def queens() -> Bool:
    return place_queen(0, empty_board())

## The benchmark, at Are We Fast Yet's own size: the eight-queens search, ten times.
##
## The original writes `result = result && queens()`, which short-circuits. `and` here is a
## primitive over two `Bool`s and evaluates both, so all ten searches run whatever the first
## returns — the same ten searches, since each of them succeeds.
def benchmark() -> Bool:
    return solve_again(0, true)

def solve_again(i: Int, solved: Bool) -> Bool:
    if i >= 10:
        return solved
    return solve_again(i + 1, solved and queens())

test "queens: eight queens placed, ten times over":
    expect benchmark()
