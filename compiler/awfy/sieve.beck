# Are We Fast Yet — Sieve.
#
# The Java original is `flags[k - 1] = false` over a 5,000-element `boolean[]`. Beck has no
# mutable array, so the sieve carries the composites it has crossed out as a `Map[Int, Bool]`:
# absent is "still prime", present is "crossed". That is the *same algorithm* — the trial divisor
# walk is Eratosthenes' either way — over a different container, and `awfy/README.md` §"What the
# port changes" is where the general rule is written down.
#
# 669 is the harness's own number: `Sieve.java`'s `verifyResult` is `669 == (int) result`.

## The benchmark, at Are We Fast Yet's own size: primes at or below 5,000.
def benchmark() -> Int:
    return sieve(2, 5000, {}, 0)

## `i` upwards, counting what is not crossed and crossing its multiples.
##
## Tail-recursive on purpose rather than by accident. The Java is a `for` with a nested `while`, and
## a transcription that recursed non-tail would spend 5,000 host frames on a loop that needs none
## — which `docs/31` made a property of the language rather than a hope about the optimiser.
def sieve(i: Int, size: Int, crossed: Map[Int, Bool], count: Int) -> Int:
    if i > size:
        return count
    if map_contains(crossed, i):
        return sieve(i + 1, size, crossed, count)
    return sieve(i + 1, size, cross_out(i + i, size, i, crossed), count + 1)

## `k`, `k + step`, `k + 2 * step`, … up to `size`.
def cross_out(k: Int, size: Int, step: Int, crossed: Map[Int, Bool]) -> Map[Int, Bool]:
    if k > size:
        return crossed
    return cross_out(k + step, size, step, map_insert(crossed, k, true))

test "sieve: 669 primes at or below 5,000":
    expect benchmark() == 669
